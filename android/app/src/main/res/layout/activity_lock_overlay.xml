<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Big Stop Icon / Shield -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛑"
        android:textSize="64sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Daily Limit Reached!"
        android:textColor="#F87171"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLockMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="You have watched your daily limit of 20 short videos.\n\nFeed access has been closed to safeguard your attention and productivity."
        android:textColor="#CBD5E1"
        android:textSize="15sp" />

    <!-- Calming box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="#1E293B"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱 Mindful Reset"
            android:textColor="#A5B4FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Take 3 deep breaths, drink some water, or stretch your neck."
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnBackToHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="#EF4444"
        android:paddingVertical="14dp"
        android:text="Return to Home Screen"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
