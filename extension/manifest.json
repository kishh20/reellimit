{
  "manifest_version": 3,
  "name": "ReelLimit - Shorts, Reels & Spotlight Focus Guard",
  "version": "1.0.0",
  "description": "Monitors watched Reels, Shorts, and Spotlight count, provides reminders every 10 videos, and enforces focus limits.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "ReelLimit Dashboard"
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.snapchat.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.snapchat.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "icons/icon-16.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.snapchat.com/*"
      ]
    }
  ]
}
